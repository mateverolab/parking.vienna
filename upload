      footer:'Esta herramienta estima el estado según la regla general de la Ciudad de Viena — no es asesoramiento oficial. No reemplaza el cartel del lugar, y si querés estar seguro, siempre chequeá las fuentes oficiales.<br>Fuente: wien.gv.at (Parkraumbewirtschaftung)',
      days:['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'],
      holidaySuffix:' · feriado', tz:'(Viena)', changesIn:'Cambia en',
      s_check:{h:'Fijate en el cartel', d:'Marcaste que la señalización local es distinta a la regla general. El cartel del lugar siempre manda.'},
      s_free:{h:'Sí, podés estacionar', d:'Fuera del horario de Kurzparkzone: no se paga ni se necesita Parkschein.'},
      s_freePickerl:{h:'Sí, con tu Parkpickerl', d:'Es horario de zona paga, pero tu Parkpickerl te exime del límite de tiempo y del costo en este distrito.'},
      s_paid:{h:'Es zona paga ahora', d:'Necesitás Parkschein. Máximo 2 horas. €1,70 cada 30 min (gratis los primeros 15 min, pero hay que completarlo igual).'},
      s_disability:{h:'Sí, gratis con tu pase', d:'Con el pase de discapacidad (§29b) válido y visible, se estaciona gratis y sin límite de tiempo acá.'},
      s_loading:{h:'Solo si estás cargando', d:'Las Ladezonen son solo para vehículos cargando o descargando en el momento. Si no es tu caso, este lugar no aplica para vos sin importar la hora.'},
      s_reserved:{h:'No, este lugar está reservado', d:'Solo pueden estacionar los vehículos con el permiso específico del cartel (vecinos, etc.) — no depende de la hora ni de tu Parkpickerl.'},
      s_disc:{h:'Sí, con disco horario', d:'Mostrá tu hora de llegada en la Parkscheibe. Es gratis, pero fijate en el cartel el tiempo máximo permitido (suele ser 1 a 2 horas).'}
    }
  };

  let lang = 'en';

  function applyStatic(){
    const t = STR[lang];
    document.title = t.docTitle;
    document.documentElement.lang = lang;
    $('txt-title').textContent = t.title;
    $('txt-subtitle').innerHTML = t.subtitle;
    $('txt-situationTitle').textContent = t.situationTitle;
    $('txt-pickerlLabel').firstChild.textContent = t.pickerlLabel;
    $('txt-pickerlSub').textContent = t.pickerlSub;
    $('txt-businessLabel').firstChild.textContent = t.businessLabel;
    $('txt-businessSub').textContent = t.businessSub;
    $('txt-stadthalleLabel').firstChild.textContent = t.stadthalleLabel;
    $('txt-stadthalleSub').textContent = t.stadthalleSub;
    $('txt-specialTitle').textContent = t.specialTitle;
    $('txt-disabilityLabel').firstChild.textContent = t.disabilityLabel;
    $('txt-disabilitySub').textContent = t.disabilitySub;
    $('txt-loadingLabel').firstChild.textContent = t.loadingLabel;
    $('txt-loadingSub').textContent = t.loadingSub;
    $('txt-reservedLabel').firstChild.textContent = t.reservedLabel;
    $('txt-reservedSub').textContent = t.reservedSub;
    $('txt-discLabel').firstChild.textContent = t.discLabel;
    $('txt-discSub').textContent = t.discSub;
    $('txt-exceptionLabel').firstChild.textContent = t.exceptionLabel;
    $('txt-exceptionSub').textContent = t.exceptionSub;
    $('txt-otherSummary').textContent = t.otherSummary;
    $('txt-other1-b').textContent = t.other1b; $('txt-other1-s').textContent = t.other1s;
    $('txt-other2-b').textContent = t.other2b; $('txt-other2-s').textContent = t.other2s;
    $('txt-other3-b').textContent = t.other3b; $('txt-other3-s').textContent = t.other3s;
    $('txt-other4-b').textContent = t.other4b; $('txt-other4-s').textContent = t.other4s;
    $('txt-other5-b').textContent = t.other5b; $('txt-other5-s').textContent = t.other5s;
    $('txt-rulesTitle').textContent = t.rulesTitle;
    $('txt-rule1').innerHTML = t.rule1;
    $('txt-rule2').innerHTML = t.rule2;
    $('txt-rule3').innerHTML = t.rule3;
    $('txt-rule4').innerHTML = t.rule4;
    $('txt-payTitle').textContent = t.payTitle;
    $('txt-payText').innerHTML = t.payText;
    $('txt-payLink').innerHTML = t.payLinkText;
    $('txt-footer').innerHTML = t.footer;
    els.langEN.classList.toggle('active', lang==='en');
    els.langES.classList.toggle('active', lang==='es');
  }

  els.langEN.addEventListener('click', ()=>{ lang='en'; applyStatic(); render(); });
  els.langES.addEventListener('click', ()=>{ lang='es'; applyStatic(); render(); });

  // Vienna local time via Intl, independent of device timezone
  function viennaNow(){
    const fmt = new Intl.DateTimeFormat('en-US', {
      timeZone:'Europe/Vienna', hour12:false,
      year:'numeric', month:'2-digit', day:'2-digit',
      hour:'2-digit', minute:'2-digit', second:'2-digit', weekday:'short'
    });
    const parts = {};
    fmt.formatToParts(new Date()).forEach(p => parts[p.type] = p.value);
    const map = {Sun:0,Mon:1,Tue:2,Wed:3,Thu:4,Fri:5,Sat:6};
    return {
      year:+parts.year, month:+parts.month, day:+parts.day,
      hour: parts.hour === '24' ? 0 : +parts.hour, minute:+parts.minute, second:+parts.second,
      weekday: map[parts.weekday],
      minutesOfDay: (parts.hour==='24'?0:+parts.hour)*60 + +parts.minute
    };
  }

  // Easter Sunday (Meeus/Jones/Butcher), returns {month, day}
  function easter(year){
    const a=year%19,b=Math.floor(year/100),c=year%100,d=Math.floor(b/4),e=b%4,
      f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),
      h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,
      l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),
      month=Math.floor((h+l-7*m+114)/31),day=((h+l-7*m+114)%31)+1;
    return {month, day};
  }

  function addDays(y,m,d,n){
    const dt = new Date(Date.UTC(y, m-1, d));
    dt.setUTCDate(dt.getUTCDate()+n);
    return {y:dt.getUTCFullYear(), m:dt.getUTCMonth()+1, d:dt.getUTCDate()};
  }

  function austrianHolidays(year){
    const fixed = [
      [1,1],[1,6],[5,1],[8,15],[10,26],[11,1],[12,8],[12,25],[12,26]
    ].map(([m,d])=>({y:year,m,d}));
    const e = easter(year);
    const movable = [
      addDays(year,e.month,e.day,1),   // Easter Monday
      addDays(year,e.month,e.day,39),  // Ascension Day
      addDays(year,e.month,e.day,50),  // Whit Monday
      addDays(year,e.month,e.day,60),  // Corpus Christi
    ];
    return [...fixed, ...movable].map(x=>`${x.y}-${x.m}-${x.d}`);
  }

  function isHoliday(v){
    const keys = new Set([...austrianHolidays(v.year-1), ...austrianHolidays(v.year), ...austrianHolidays(v.year+1)]);
    return keys.has(`${v.year}-${v.month}-${v.day}`);
  }

  // Priority: explicit override > hard restrictions (reserved/loading) > disc > disability > standard time-based calc
  function stateAt(v, opts){
    if(opts.exception) return 'check';
    if(opts.reserved) return 'reserved';
    if(opts.loading) return 'loading';
    if(opts.disc) return 'disc';
    if(opts.disability) return 'free_disability';
    const weekday = v.weekday>=1 && v.weekday<=5;
    const holiday = isHoliday(v);
    const mins = v.minutesOfDay;
    const inStandard = weekday && !holiday && mins>=9*60 && mins<22*60;
    const inStadthalleWeekend = opts.stadthalle && (!weekday || holiday) && mins>=18*60 && mins<22*60;
    const zonePaid = inStandard || inStadthalleWeekend;
    if(!zonePaid) return 'free';
    if(opts.pickerl && !opts.business) return 'free_pickerl';
    return 'paid';
  }

  const TIME_BASED = ['free','free_pickerl','paid'];

  function render(){
    const t = STR[lang];
    const v = viennaNow();
    const opts = {
      pickerl: els.tPickerl.checked,
      business: els.tBusiness.checked,
      stadthalle: els.tStadthalle.checked,
      disability: els.tDisability.checked,
      loading: els.tLoading.checked,
      reserved: els.tReserved.checked,
      disc: els.tDisc.checked,
      exception: els.tException.checked
    };
    const state = stateAt(v, opts);

    els.clockTime.textContent =
      String(v.hour).padStart(2,'0')+':'+String(v.minute).padStart(2,'0')+':'+String(v.second).padStart(2,'0')+' '+t.tz;
    els.clockDay.textContent = t.days[v.weekday] + (isHoliday(v) ? t.holidaySuffix : '');

    els.card.classList.remove('state-free','state-paid','state-check');

    const map = {
      check:{cls:'state-check', icon:'?', s:t.s_check},
      reserved:{cls:'state-paid', icon:'✕', s:t.s_reserved},
      loading:{cls:'state-check', icon:'L', s:t.s_loading},
      disc:{cls:'state-free', icon:'D', s:t.s_disc},
      free_disability:{cls:'state-free', icon:'♿', s:t.s_disability},
      free:{cls:'state-free', icon:'P', s:t.s_free},
      free_pickerl:{cls:'state-free', icon:'P', s:t.s_freePickerl},
      paid:{cls:'state-paid', icon:'€', s:t.s_paid}
    };
    const m = map[state];
    els.card.classList.add(m.cls);
    els.icon.textContent = m.icon;
    els.headline.textContent = m.s.h;
    els.detail.textContent = m.s.d;

    els.ring.style.setProperty('--pct', (v.second/60*100)+'%');
    els.countdown.textContent = TIME_BASED.includes(state) ? nextChangeLabel(v, opts, state, t) : '';
  }

  function nextChangeLabel(v, opts, currentState, t){
    let y=v.year, mo=v.month, d=v.day, h=v.hour, mi=v.minute;
    let wd = v.weekday;
    for(let step=1; step<=4*24*60; step++){
      mi++;
      if(mi>=60){mi=0;h++;}
      if(h>=24){h=0;d++;wd=(wd+1)%7;
        const dt = new Date(Date.UTC(y,mo-1,d));
        y=dt.getUTCFullYear();mo=dt.getUTCMonth()+1;d=dt.getUTCDate();
      }
      const vv = {year:y,month:mo,day:d,weekday:wd,minutesOfDay:h*60+mi};
      const s = stateAt(vv, opts);
      const simplified = s==='free_pickerl' ? 'free' : s;
      const currentSimplified = currentState==='free_pickerl' ? 'free' : currentState;
      if(simplified !== currentSimplified){
        const totalMin = step - v.second/60;
        const hh = Math.floor(totalMin/60), mm = Math.round(totalMin%60);
        const when = hh>0 ? `${hh}h ${mm}min` : `${mm}min`;
        return `${t.changesIn} ${when}`;
      }
    }
    return '';
  }

  [els.tPickerl, els.tBusiness, els.tStadthalle, els.tDisability, els.tLoading, els.tReserved, els.tDisc, els.tException].forEach(el=>{
    el.addEventListener('change', render);
  });

  applyStatic();
  render();
  setInterval(render, 1000);
})();
</script>
